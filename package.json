{
  "name": "grantecho",
  "version": "1.0.0",
  "description": "SIP-031 Grant Proposal Tracker for Stacks Governance",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "check": "clarinet check",
    "console": "clarinet console",
    "deploy:testnet": "NETWORK=testnet ts-node scripts/deploy.ts",
    "deploy:mainnet": "NETWORK=mainnet ts-node scripts/deploy.ts"
  },
  "keywords": [
    "stacks",
    "clarity",
    "governance",
    "sip-031",
    "bitcoin",
    "l2",
    "grants",
    "voting",
    "dao"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hirosystems/clarinet-sdk": "^3.0.2",
    "@stacks/network": "^7.0.6",
    "@stacks/transactions": "^7.0.6",
    "@types/node": "^22.15.18",
    "chokidar-cli": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0",
    "vitest": "^3.1.3",
    "vitest-environment-clarinet": "^2.3.0"
  }
}
